{
  "name": "maxminddb",
  "description": "Look up IP locations and network ownership in local MaxMind databases.",
  "author": {
    "name": "Greg Oschwald",
    "url": "https://github.com/oschwald"
  },
  "homepage": "https://github.com/oschwald/maxminddb-mcp",
  "license": "ISC",
  "keywords": ["geoip", "maxmind", "mmdb", "ip", "asn"],
  "version": "0.3.0",
  "repository": "https://github.com/oschwald/maxminddb-mcp",
  "skills": "./packaging/skills/",
  "logo": "packaging/icon.png",
  "variables": {
    "type": "object",
    "properties": {
      "MAXMINDDB_MCP_ACCOUNT_ID": {
        "type": "string",
        "title": "MaxMind account ID",
        "description": "Your numeric MaxMind account ID."
      },
      "MAXMINDDB_MCP_LICENSE_KEY": {
        "type": "string",
        "title": "MaxMind license key",
        "description": "Your MaxMind license key with database download access."
      },
      "MAXMINDDB_MCP_EDITIONS": {
        "type": "string",
        "title": "Database editions",
        "description": "Comma-separated MMDB edition IDs available to your account.",
        "default": "GeoLite2-City,GeoLite2-ASN"
      }
    },
    "required": ["MAXMINDDB_MCP_ACCOUNT_ID", "MAXMINDDB_MCP_LICENSE_KEY"]
  },
  "mcpServers": {
    "maxminddb": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--mount",
        "type=volume,source=maxminddb-mcp-data,target=/data",
        "--env",
        "MAXMINDDB_MCP_CONFIG=",
        "--env",
        "MAXMINDDB_MCP_DOWNLOAD_ENABLED=true",
        "--env",
        "MAXMINDDB_MCP_DATABASE_DIR=/data",
        "--env",
        "MAXMINDDB_MCP_ACCOUNT_ID",
        "--env",
        "MAXMINDDB_MCP_LICENSE_KEY",
        "--env",
        "MAXMINDDB_MCP_EDITIONS",
        "ghcr.io/oschwald/maxminddb-mcp:0.3.0"
      ],
      "env": {
        "MAXMINDDB_MCP_ACCOUNT_ID": "${MAXMINDDB_MCP_ACCOUNT_ID}",
        "MAXMINDDB_MCP_LICENSE_KEY": "${MAXMINDDB_MCP_LICENSE_KEY}",
        "MAXMINDDB_MCP_EDITIONS": "${MAXMINDDB_MCP_EDITIONS}"
      }
    }
  }
}
